# Python
__pycache__/
*.py[cod]
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
build/
dist/
.next/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment. The example file is committed on purpose; the real ones never are.
.env
.env.*
!.env.example

# Alembic local files. Migration versions under alembic/versions/ are committed.
alembic.ini.local
alembic/versions/__pycache__/
*.db
*.sqlite3

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Deliberately not ignored, so nobody adds them later by reflex:
#   CLAUDE.md      the spec
#   DECISIONS.md   the public log
#   .claude/       skills, slash commands, hooks and committed settings

# Two exceptions inside .claude/. Local settings are per-machine, not project config: they hold
# absolute paths from whoever's laptop wrote them, so they are noise in a public repo.
.claude/settings.local.json

# Archived transcripts, written by the PreCompact hook before compaction discards the window.
# They are unencrypted plaintext of everything a tool printed, so they can contain database
# credentials the moment a command echoes .env. Never committed.
.claude/transcripts/
