# Copy to .env and set a password. .env is gitignored and never committed.
POSTGRES_USER=kanban
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kanban

# The one origin the browser is allowed to make state-changing requests from.
# Optional: it defaults to this value. Set it when the app is not on localhost.
# There is deliberately no session secret here. Sessions are opaque random tokens
# looked up in Postgres, so there is no signature to sign and no key to leak.
ALLOWED_ORIGIN=http://localhost:5173

# The agent's OpenRouter key, read by the back-end and never sent to the browser.
# Leave it unset to run everything except the assistant: that endpoint then
# answers 503 saying so, and the rest of the app is unaffected.
# The model slug is not configured here on purpose. It is pinned in
# backend/app/config.py so that changing it is a commit somebody reviews.
OPENROUTER_API_KEY=
