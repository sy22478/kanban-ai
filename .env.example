# Copy to .env and set a password. .env is gitignored and never committed.
POSTGRES_USER=kanban
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kanban

# The one origin the browser is allowed to make state-changing requests from.
# Optional: it defaults to this value. Set it when the app is not on localhost.
# There is deliberately no session secret here. Sessions are opaque random tokens
# looked up in Postgres, so there is no signature to sign and no key to leak.
ALLOWED_ORIGIN=http://localhost:5173
